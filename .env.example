# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
# The anon key is public by design (RLS protects the data); it is baked into the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: enables "Sign in with Google". The web app's Google OAuth *Web* client ID
# (xxxxxxxx.apps.googleusercontent.com). Also create an Android OAuth client — see README.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: Android package id (default com.noteforge.vault). Can never change after the
# first release. Must match the package name on the Google Android OAuth clients.
# APP_PACKAGE=com.noteforge.vault
# Optional: enables "KeePassXC file on OneDrive". The web app's NEXT_PUBLIC_AZURE_CLIENT_ID and
# NEXT_PUBLIC_AZURE_TENANT (same Azure app registration). In Azure → Authentication add a
# "Mobile and desktop applications" platform and tick the suggested  msal<client id>://auth
EXPO_PUBLIC_AZURE_CLIENT_ID=
EXPO_PUBLIC_AZURE_TENANT=common
